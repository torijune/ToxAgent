"""
Task3 CoT: remove only_toxic_safe_fragments, add only_nontoxic_safe_fragments instruction.

Used to build a reasoning/instruction block for task3_nontoxic_smiles_generation
so that the prompt explicitly tells the model which fragments to remove and which to add.
Data source: only_toxic_safe_fragments, only_nontoxic_safe_fragments from
merged_train.csv (train split) or merged_test.csv (test split).
"""

from typing import Optional


def build_cot_instruction(
    only_toxic_safe_fragments: str,
    only_nontoxic_safe_fragments: str,
    step: str = "multi_step",
) -> str:
    """Build the remove/add CoT instruction for task3.

    Args:
        only_toxic_safe_fragments: SAFE fragment(s) to remove (toxicity-associated).
        only_nontoxic_safe_fragments: SAFE fragment(s) to add as replacement.
        step: "single_step" (one fragment) or "multi_step" (multiple). Affects wording.

    Returns:
        A short instruction paragraph to be inserted into the task3 prompt.
    """
    remove_s = (only_toxic_safe_fragments or "").strip()
    add_s = (only_nontoxic_safe_fragments or "").strip()

    if step == "single_step":
        remove_phrase = "Remove the following toxicity-associated fragment from the toxic molecule"
        add_phrase = "add the following non-toxic replacement fragment"
    else:
        remove_phrase = "Remove the following toxicity-associated fragment(s) from the toxic molecule"
        add_phrase = "add the following non-toxic replacement fragment(s)"

    parts = [
        f"Instruction (reasoning): {remove_phrase}: {remove_s!r}. "
        f"Then {add_phrase}: {add_s!r}. "
        "Output the resulting non-toxic molecule as a single SMILES string."
    ]
    return " ".join(parts).strip()
